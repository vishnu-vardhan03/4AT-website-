PORT=5000
NODE_ENV=development
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/4at_consulting
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace-with-database-password
DB_NAME=4at_consulting
DB_SSL=false
# Keep certificate verification enabled in production. Set false only when your
# managed database provider explicitly requires it and documents the trade-off.
DB_SSL_REJECT_UNAUTHORIZED=true
# CORS allow-list. FRONTEND_URL and ALLOWED_ORIGINS are unioned, so set either or both;
# both accept a comma-separated list.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
# Admin login is bcrypt-only and fails closed: without BOTH of these set there is no admin
# account. Generate the hash with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1],12))" 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
JWT_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_SECRET=replace-with-the-frontend-nextauth-secret
ESSL_INTERNAL_API_KEY=replace-with-the-same-strong-random-key-used-by-the-frontend
# Absolute private path backed by persistent storage in production. Never expose
# this directory through a static-file server.
ESSL_UPLOAD_DIR=/absolute/path/to/persistent/essl-uploads
# Microsoft Graph email delivery (client credentials; never commit the secret value)
EMAIL_ENABLED=true
MICROSOFT_TENANT_ID=replace-with-microsoft-entra-tenant-id
MICROSOFT_CLIENT_ID=replace-with-microsoft-entra-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-entra-client-secret-value
ESS_SENDER_EMAIL=esssupport@consult-4at.com
IT_ACCESS_EMAIL=esssupport@consult-4at.com
FOOD_CAB_EMAIL=hrd@consult-4at.com
FINANCE_FACILITIES_EMAIL=b.aryasomayajula@consult-4at.com
OTHER_EMAIL=b.aryasomayajula@consult-4at.com
MANDATORY_CC_EMAILS=shashank@consult-4at.com,prudviraju@consult-4at.com
ESS_FRONTEND_URL=http://localhost:3000/essl
# Daily EOD summary. Standard five-field cron; this example sends at 6:00 PM India time.
EOD_SUMMARY_ENABLED=false
EOD_SUMMARY_CRON=0 18 * * *
EOD_SUMMARY_TIMEZONE=Asia/Kolkata
EOD_SUMMARY_RECIPIENT=esssupport@consult-4at.com
