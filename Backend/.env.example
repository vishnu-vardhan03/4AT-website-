PORT=5000
NODE_ENV=development
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/4at_consulting
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace-with-database-password
DB_NAME=4at_consulting
DB_SSL=false
# CORS allow-list. FRONTEND_URL and ALLOWED_ORIGINS are unioned, so set either or both;
# both accept a comma-separated list.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
# Admin login is bcrypt-only and fails closed: without BOTH of these set there is no admin
# account. Generate the hash with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1],12))" 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
JWT_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_SECRET=replace-with-the-frontend-nextauth-secret
ESSL_INTERNAL_API_KEY=replace-with-the-same-strong-random-key-used-by-the-frontend
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_FROM=4AT IT Support <itsupport@consult-4at.com>
SMTP_REPLY_TO=itsupport@consult-4at.com
IT_SUPPORT_EMAIL=itsupport@consult-4at.com
ESSL_TICKET_BASE_URL=http://localhost:3000/essl
